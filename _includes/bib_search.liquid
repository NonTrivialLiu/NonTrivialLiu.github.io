{% if site.bib_search %}
  {% assign bib_search_placeholder = 'search.bibliography_placeholder' | t %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <!-- prettier-ignore -->
  <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="{{ bib_search_placeholder | escape }}">
{% endif %}
